rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    match /maid-id-proofs/{maidId}/{fileName} {
      allow read, write: if request.auth != null
                          && request.auth.uid == maidId;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}